(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the white mug on the left plate, then put the yellow and white mug on the right plate, then put the chocolate pudding on the added plate, and finally put the red mug to the right of the added plate.)
  (:regions
      (plate_left_region
          (:target living_room_table)
          (:ranges (
              (-0.025 -0.325 0.025 -0.27499999999999997)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate2_init_region
          (:target living_room_table)
          (:ranges (
              (-0.025 0.27499999999999997 0.025 0.325)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_init_region
          (:target living_room_table)
          (:ranges (
              (-0.125 -0.175 -0.07500000000000001 -0.125)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_yellow_mug_init_region
          (:target living_room_table)
          (:ranges (
              (-0.07500000000000001 0.07500000000000001 -0.025 0.125)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_init_region
          (:target living_room_table)
          (:ranges (
              (-0.225 -0.025 -0.17500000000000002 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate3_init_region
          (:target living_room_table)
          (:ranges (
              (0.125000 -0.025000 0.175000 0.025000)
            )
          )
          (:yaw_rotation (
              (0.000000000000 0.000000000000)
            )
          )
      )
      (plate_right_region
          (:target living_room_table)
          (:ranges (
              (0.100000 0.050000 0.200000 0.150000)
            )
          )
          (:yaw_rotation (
              (0.000000000000 0.000000000000)
            )
          )
      )
      (chocolate_pudding_init_region
          (:target living_room_table)
          (:ranges (
              (-0.275000 0.075000 -0.225000 0.125000)
            )
          )
          (:yaw_rotation (
              (0.000000000000 0.000000000000)
            )
          )
      )
  )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    porcelain_mug_1 - porcelain_mug
    red_coffee_mug_1 - red_coffee_mug
    white_yellow_mug_1 - white_yellow_mug
    plate_1 plate_2 plate_3 - plate
    chocolate_pudding_1 - chocolate_pudding
  )

  (:obj_of_interest
    porcelain_mug_1
    plate_1
    white_yellow_mug_1
    plate_2
    chocolate_pudding_1
    plate_3
    red_coffee_mug_1
    living_room_table_plate_right_region
  )

  (:init
    (On plate_1 living_room_table_plate_left_region)
    (On plate_2 living_room_table_plate2_init_region)
    (On red_coffee_mug_1 living_room_table_red_coffee_mug_init_region)
    (On white_yellow_mug_1 living_room_table_white_yellow_mug_init_region)
    (On porcelain_mug_1 living_room_table_porcelain_mug_init_region)
    (On plate_3 living_room_table_plate3_init_region)
    (On chocolate_pudding_1 living_room_table_chocolate_pudding_init_region)
  )

  (:goal
    (And (On porcelain_mug_1 plate_1) (On white_yellow_mug_1 plate_2) (On chocolate_pudding_1 plate_3) (On red_coffee_mug_1 living_room_table_plate_right_region))
  )

)
