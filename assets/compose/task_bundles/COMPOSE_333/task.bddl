(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Turn on the first stove, then put the moka pot on the first stove, and finally move the moka pot to the other stove.)
  (:regions
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.21000000000000002 0.19 -0.19 0.21000000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_init_region
          (:target kitchen_table)
          (:ranges (
              (0.025 -0.025 0.07500000000000001 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
      (flat_stove_2_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.210000 -0.210000 -0.190000 -0.190000)
            )
          )
          (:yaw_rotation (
              (0.000000000000 0.000000000000)
            )
          )
      )
      (cook_region
          (:target flat_stove_2)
      )
  )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 flat_stove_2 - flat_stove
  )

  (:objects
    moka_pot_1 - moka_pot
  )

  (:obj_of_interest
    flat_stove_1
    moka_pot_1
    flat_stove_1_cook_region
    flat_stove_2_cook_region
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_init_region)
    (On moka_pot_1 kitchen_table_moka_pot_init_region)
    (On flat_stove_2 kitchen_table_flat_stove_2_init_region)
  )

  (:goal
    (And (Turnon flat_stove_1) (On moka_pot_1 flat_stove_2_cook_region))
  )

)
