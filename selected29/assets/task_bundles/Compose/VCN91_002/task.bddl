(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the black bowl on top of the cabinet, then turn on the stove, then put the moka pot on the stove.)
  (:regions
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.21000000000000002 0.19 -0.19 0.21000000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (frypan_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.07500000000000001 -0.275 -0.025 -0.225)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_init_region
          (:target kitchen_table)
          (:ranges (
              (0.025 -0.025 0.07500000000000001 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
      (b91_cabinet_parser_only
          (:target kitchen_table)
          (:ranges (
              (-0.080000 -0.250000 -0.060000 -0.230000)
            )
          )
          (:yaw_rotation (
              (3.141592653590 3.141592653590)
            )
          )
      )
      (b91_bowl_parser_only
          (:target kitchen_table)
          (:ranges (
              (-0.200000 -0.010000 -0.180000 0.010000)
            )
          )
          (:yaw_rotation (
              (0.000000000000 0.000000000000)
            )
          )
      )
      (top_region
          (:target wooden_cabinet_1)
      )
      (middle_region
          (:target wooden_cabinet_1)
      )
      (bottom_region
          (:target wooden_cabinet_1)
      )
      (top_side
          (:target wooden_cabinet_1)
      )
  )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
    wooden_cabinet_1 - wooden_cabinet
  )

  (:objects
    moka_pot_1 - moka_pot
    akita_black_bowl_1 - akita_black_bowl
  )

  (:obj_of_interest
    akita_black_bowl_1
    flat_stove_1
    moka_pot_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_init_region)
    (On moka_pot_1 kitchen_table_moka_pot_init_region)
    (On wooden_cabinet_1 kitchen_table_b91_cabinet_parser_only)
    (On akita_black_bowl_1 kitchen_table_b91_bowl_parser_only)
  )

  (:goal
    (And (On akita_black_bowl_1 wooden_cabinet_1_top_side) (Turnon flat_stove_1) (On moka_pot_1 flat_stove_1_cook_region))
  )

)
