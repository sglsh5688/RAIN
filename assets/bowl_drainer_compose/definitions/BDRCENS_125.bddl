(define
  (problem libero_floor_manipulation)
  (:domain robosuite)
  (:language Pick the ketchup and place it in the left compartment of the bowl drainer, then pick the milk and place it in the right compartment of the bowl drainer.)
  (:regions (bin_region (:target floor) (:ranges ((-0.01000000 0.24471000 0.01000000 0.26471000)))) (target_object_region (:target floor) (:ranges ((-0.145 -0.265 -0.095 -0.215)))) (other_object_region_0 (:target floor) (:ranges ((0.025 -0.125 0.07500000000000001 -0.07500000000000001)))) (other_object_region_1 (:target floor) (:ranges ((-0.175 0.034999999999999996 -0.125 0.08499999999999999)))) (other_object_region_2 (:target floor) (:ranges ((0.07500000000000001 -0.225 0.125 -0.17500000000000002)))) (other_object_region_3 (:target floor) (:ranges ((0.125 0.0049999999999999975 0.175 0.055)))) (other_object_region_4 (:target floor) (:ranges ((-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)))) (left_region (:target bowl_drainer_1)) (right_region (:target bowl_drainer_1)))
  (:fixtures floor - floor bowl_drainer_1 - bowl_drainer)
  (:objects ketchup_1 - ketchup bbq_sauce_1 - bbq_sauce salad_dressing_1 - salad_dressing alphabet_soup_1 - alphabet_soup cream_cheese_1 - cream_cheese milk_1 - milk)
  (:obj_of_interest ketchup_1 bowl_drainer_1_left_region milk_1 bowl_drainer_1_right_region)
  (:init (on ketchup_1 floor_target_object_region) (on bbq_sauce_1 floor_other_object_region_0) (on salad_dressing_1 floor_other_object_region_1) (on alphabet_soup_1 floor_other_object_region_2) (on cream_cheese_1 floor_other_object_region_3) (on milk_1 floor_other_object_region_4) (on bowl_drainer_1 floor_bin_region))
  (:goal (and (in ketchup_1 bowl_drainer_1_left_region) (in milk_1 bowl_drainer_1_right_region)))
)
